      "title": "Stations heard",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "station",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Value #A": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "Value #B": "Mean SNR",
              "Value #C": "Last SNR",
              "Value #D": "Mean offset",
              "Value #E": "Frames/s",
              "Value #F": "Corrected bytes/s",
              "mode": "Mode",
              "station": "Station",
              "sub_channel": "Sub-channel"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "One point per received frame: SNR against the time the frame was actually heard, coloured by station. Raw points from measurement pdn_frame, with no GROUP BY time and no aggregation function, so nothing is averaged away.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "SNR",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "points",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 0,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "always",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "dB"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "count",
            "mean",
            "min",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "sortBy": "Count",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "alias": "$tag_station $tag_mode",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "groupBy": [
            {
              "params": [
                "station"
              ],
              "type": "tag"
            }
          ],
          "measurement": "pdn_frame",
          "orderByTime": "ASC",
          "policy": "autogen",
          "query": "SELECT \"snr_db\" FROM \"autogen\".\"pdn_frame\" WHERE $timeFilter AND \"station\" =~ /^($station)$/ GROUP BY \"station\",\"mode\"",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series",
          "select": [
            [
              {
                "params": [
                  "snr_db"
                ],
                "type": "field"
              }
            ]
          ],
          "tags": [
            {
              "key": "station",
              "operator": "=~",
              "value": "/^($station)$/"
            }
          ]
        }
      ],
      "title": "Per-frame SNR scatter",
      "type": "timeseries"
    },
