{
  // A starter: it runs, but it listens to nothing (the audio goes round a private pipe).
  // To set the station up, open http://<this machine>:8107/config in a browser.
  // Every setting: https://github.com/packet-net/pdn-soundmodem/blob/main/docs/reference/config.md
  "device": "pipe:/var/lib/pdn-soundmodem/starter-air,/var/lib/pdn-soundmodem/starter-air",
  "bind": "*",
  "modems": [
    { "subChannel": 0, "mode": "afsk1200" }
  ],
  "waterfall": { "port": 8107 }
}
