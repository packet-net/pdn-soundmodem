{
  // Two OFDM-FM profiles on one radio at once. They occupy different parts of the audio
  // passband, so both receivers run on the same samples and either can transmit; the KISS
  // port nibble picks which one a frame goes out on.
  //
  // Both profiles must exist in the plugin's geometry file. Start-up lists what was found:
  //   modem plugin: ofdm-fm from /opt/pdn/plugins/M0LTE.OfdmFm.dll [ofdm-fm:nb, ofdm-fm:enb, ...]
  // and a "modems" entry naming one that is not there stops start-up as an unknown mode.
  "device": "plughw:1,0",
  "captureRate": 48000,

  "modemPlugins": [
    { "path": "/opt/pdn/plugins/M0LTE.OfdmFm.dll" }
  ],

  "modems": [
    { "subChannel": 0, "mode": "ofdm-fm:nb" },

    // A modem given a TCP port of its own. That port carries only this modem and presents it
    // as nibble 0, which is what host software that hardcodes KISS channel 0 needs in order to
    // reach a modem that is not sub-channel 0.
    { "subChannel": 1, "mode": "ofdm-fm:wb", "port": 8110 }
  ],

  "ptt": { "type": "cm108", "device": "/dev/hidraw0", "gpio": 3 },
  "kissPort": 8105,
  "bind": "127.0.0.1"
}
