{
  // A bench or loopback station with NO geometry file installed.
  //
  // The plugin always declares at least one mode. With no ofdm-fm.local.json anywhere on its
  // search path it offers exactly one, "synthetic", whose geometry is invented and published
  // in the plugin's own source. That is enough to prove the audio path, the KISS port, PTT
  // keying and the plugin seam itself, and it is NOT the waveform a station runs on air.
  //
  // Useful precisely because it needs nothing private installed: this config works on a fresh
  // clone with only the plugin built.
  "device": "plughw:2,0",
  "captureRate": 48000,

  "modemPlugins": [
    { "path": "/opt/pdn/plugins/M0LTE.OfdmFm.dll" }
  ],

  "modems": [
    { "subChannel": 0, "mode": "ofdm-fm:synthetic" }
  ],

  "kissPort": 8105,
  "bind": "127.0.0.1"
}
