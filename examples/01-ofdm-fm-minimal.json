{
  // The smallest configuration that runs OFDM-FM. Everything else in this directory adds to it.
  //
  // Start with: pdn-soundmodem --config 01-ofdm-fm-minimal.json
  "device": "plughw:1,0",

  // MUST be 48000 for any ofdm-fm mode. The plugin offers every profile at one host rate and
  // that rate is 48 kHz, so a 12000 channel simply will not have these modes on it.
  "captureRate": 48000,

  // The waveform is not in this package and is not scanned for: this path is the only thing
  // loaded. Use an absolute path in anything systemd starts, because "relative" means relative
  // to the service's working directory rather than to this file.
  "modemPlugins": [
    { "path": "/opt/pdn/plugins/M0LTE.OfdmFm.dll" }
  ],

  // Plugin modes are named pluginId:mode, so this can never collide with a built-in. The
  // profile names come from the plugin's geometry file - see README.md in this directory.
  // Do NOT add "frequency" to an ofdm-fm modem: the waveform occupies the band its profile
  // puts it in and has no frequency translation, so a centre is refused at start-up rather
  // than accepted and ignored.
  "modems": [
    { "subChannel": 0, "mode": "ofdm-fm:nb" }
  ],

  "kissPort": 8105,
  "bind": "127.0.0.1"
}
