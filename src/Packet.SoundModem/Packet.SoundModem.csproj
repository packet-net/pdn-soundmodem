<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>pdn-soundmodem</PackageId>
    <Description>Headless soundcard packet modem core: IL2P/AX.25 framing and FEC now; demodulators, KISS TCP and DCD to follow.</Description>
    <PackageTags>packet-radio;ax25;il2p;soundmodem;kiss;fec;reed-solomon;amateur-radio</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" />
    <!-- FlexRadio 6000-series client, lifted out of this repo into its own package. -->
    <!-- Build against a local M0LTE.Flex checkout with
         `-p:FlexSourcePath=/path/to/M0LTE.Flex/src/M0LTE.Flex/M0LTE.Flex.csproj`.
         The Flex work here is co-developed with that library and the radio is the only
         authority on how it behaves, so iterating means editing both and testing on air -
         a pack/publish round trip per change is friction with nothing to show for it.
         Unset (the default and what CI uses), the published package is consumed. -->
    <PackageReference Include="M0LTE.Flex" Condition="'$(FlexSourcePath)' == ''" />
    <!-- The AX.25 codec and link observer, so nothing here has to reimplement either. The
         package is AGPL-3.0-or-later (0.23.0 was the last MIT release; the pin moved to
         0.31.0 for the link observer, 0.32.0 for its giving up on unanswered calls and
         0.33.0 for acknowledgements counting as a link), which CLAUDE.md allows alongside
         this library's
         GPL-3.0-or-later by way of GPLv3 §13, the same footing as M0LTE.Flex. The
         dependency runs the safe way round: packet.net's AX.25 package knows nothing about
         this modem. Build against a local packet.net checkout with
         `-p:Ax25SourcePath=/path/to/packet.net/src/Packet.Ax25/Packet.Ax25.csproj`, the
         same pattern as FlexSourcePath, while the two are developed together. -->
    <PackageReference Include="Packet.Ax25" Condition="'$(Ax25SourcePath)' == ''" />
    <PackageReference Include="M0LTE.Radio.Audio" />
    <!-- Same local-checkout override pattern as FlexSourcePath, for the FEC, IL2P and
         ARDOP packages - the receive campaigns iterate across these repos. -->
    <PackageReference Include="M0LTE.Fec" Condition="'$(FecSourcePath)' == ''" />
    <PackageReference Include="M0LTE.Il2p" Condition="'$(Il2pSourcePath)' == ''" />
    <PackageReference Include="M0LTE.Ardop" Condition="'$(ArdopSourcePath)' == ''" />
    <PackageReference Include="M0LTE.Pocsag" />
    <!-- DSP primitives, OFDM modem and LDPC codec, each lifted out into its own package. -->
    <PackageReference Include="M0LTE.Dsp" />
    <PackageReference Include="M0LTE.FecLdpc" />
    <PackageReference Include="M0LTE.Ofdm" />
    <!-- The `ubersdr:` receive device: UberSDR streams its IQ as zstd-compressed PCM frames. -->
    <PackageReference Include="ZstdSharp.Port" />
  </ItemGroup>

  <ItemGroup Condition="'$(FlexSourcePath)' != ''">
    <ProjectReference Include="$(FlexSourcePath)" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ax25SourcePath)' != ''">
    <ProjectReference Include="$(Ax25SourcePath)" />
  </ItemGroup>

  <ItemGroup Condition="'$(Il2pSourcePath)' != ''">
    <ProjectReference Include="$(Il2pSourcePath)" />
  </ItemGroup>

  <ItemGroup Condition="'$(FecSourcePath)' != ''">
    <ProjectReference Include="$(FecSourcePath)" />
  </ItemGroup>

  <ItemGroup Condition="'$(ArdopSourcePath)' != ''">
    <ProjectReference Include="$(ArdopSourcePath)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The browser waterfall page, served whole by WaterfallWebServer - a single
         self-contained file, no external assets. -->
    <EmbeddedResource Include="Waterfall/wwwroot/waterfall.html" />
    <!-- The picker: the front page of a site that offers several receivers. Served by the
         daemon's monitor host rather than by a waterfall server, and self-contained the same
         way. Embedded here because it is one design with the page it links to. -->
    <EmbeddedResource Include="Waterfall/wwwroot/monitor.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Packet.SoundModem.Tests" />
    <!-- The OTA scorer re-encodes the transmitted bit stream to measure UNCODED error rate,
         which needs the same framing/puncture/interleave internals the mask suite uses. It has
         to be the production encoder rather than a copy: a scorer with its own idea of the wire
         order would grade the demodulator against a fiction and never say so. -->
    <InternalsVisibleTo Include="sm-ota" />
  </ItemGroup>

</Project>
