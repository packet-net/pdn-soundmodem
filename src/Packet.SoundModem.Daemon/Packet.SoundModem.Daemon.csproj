<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pdn-soundmodem</AssemblyName>
    <!-- The NuGet restore identity must differ from the library's PackageId
         (pdn-soundmodem); the shipped binary name comes from AssemblyName above. -->
    <PackageId>pdn-soundmodem-daemon</PackageId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Packet.SoundModem/Packet.SoundModem.csproj" />
    <!-- Finding the machine's radio interfaces for the configuration page's "found on this
         machine" choices: the same sysfs reading the Linux library does for its apps. -->
    <ProjectReference Include="../Packet.SoundModem.Linux/Packet.SoundModem.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The frame log's store. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <!-- The STANAG 5066 node an "s5066" section starts (S5066Station). -->
    <PackageReference Include="M0LTE.S5066.Host" />
    <!-- The GPSDO display's reference state (a "gpsdo" section, GpsdoFeed). Already pinned for
         the NinoCompare tool. -->
    <PackageReference Include="MQTTnet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The configuration page, and the reference page its help text is read from (ConfigHelp),
         so the help beside each field is the sentence the reference already has for the key. -->
    <EmbeddedResource Include="wwwroot/config.html" LogicalName="config.html" />
    <EmbeddedResource Include="../../soundmodem.example.json" LogicalName="soundmodem.example.json" Link="soundmodem.example.json" />
    <EmbeddedResource Include="../../docs/reference/config.md" LogicalName="config-reference.md" Link="wwwroot/config-reference.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- DeviceDiagnostics' messages are the first thing an admin reads in journalctl on a
         fresh install, so they are pinned by tests. -->
    <InternalsVisibleTo Include="Packet.SoundModem.Tests" />
  </ItemGroup>

</Project>
