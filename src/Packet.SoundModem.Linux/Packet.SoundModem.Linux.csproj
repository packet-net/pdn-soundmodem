<Project Sdk="Microsoft.NET.Sdk">

  <!-- Linux radio interface support for applications that run the soundmodem core in their own
       process: finding which ALSA card, hidraw node and serial port belong to one USB interface
       (sysfs), checking the operator can open them, noticing plugs and unplugs, saying who holds a
       busy card (PipeWire, PulseAudio), and the mixer rules a radio interface needs (nothing above
       0 dB, AGC and boost off, the mic monitor path closed), over the core's ALSA classes.

       A separate library, as the Windows one is: the daemon does not reference it, so nothing
       here reaches its package, and it builds (but only runs) anywhere. -->

  <PropertyGroup>
    <PackageId>pdn-soundmodem-linux</PackageId>
    <Description>Linux radio interface discovery (ALSA, hidraw, serial by USB device), device access checks, hot-plug, and mixer hygiene and levels for pdn-soundmodem.</Description>
    <PackageTags>packet-radio;soundmodem;alsa;cm108;aioc;ptt;amateur-radio;linux</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- LibraryImport's generated marshalling for realpath and access. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AGPL-3.0-or-later, as the Windows library is. New code, written for the Linux app;
         none of the GPL-only files LICENSING.md lists is in it, so unlike the core package its
         licence needs no GPL term. -->
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Packet.SoundModem/Packet.SoundModem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Packet.SoundModem.Linux.Tests" />
  </ItemGroup>

</Project>
