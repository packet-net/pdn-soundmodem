<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Watterson rig lives here but is compiled by the OTA tool, which injects the same
         channel at the transmitter for §E2. One definition, reached from both sides; the file
         stays here because this is where it belongs and where it is maintained. -->
    <Compile Remove="Channel/WattersonChannel.cs" />
    <Compile Remove="Channel/ImpulseNoise.cs" />
    <Compile Remove="Channel/FmChannel.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The frame log's store, for reading a written log back in FrameLogTests. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Packet.SoundModem/Packet.SoundModem.csproj" />
    <!-- The daemon, for DaemonConfig's operator-facing load errors (DaemonConfigTests). Those
         messages are what an admin gets in journalctl, so they are worth pinning. -->
    <ProjectReference Include="../../src/Packet.SoundModem.Daemon/Packet.SoundModem.Daemon.csproj" />
    <!-- Dev tool under test: the ka9q_ubersdr IQ capture decoder (UberSdrPcmDecoderTests). -->
    <ProjectReference Include="../../tools/Packet.SoundModem.UberSdr/Packet.SoundModem.UberSdr.csproj" />
    <!-- Dev tool under test: the OTA transmit harness (Ota/*Tests). -->
    <ProjectReference Include="../../tools/Packet.SoundModem.Ota/Packet.SoundModem.Ota.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page probe is run by Node from the test output directory. -->
    <None Include="Waterfall/browser/page-probe.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
