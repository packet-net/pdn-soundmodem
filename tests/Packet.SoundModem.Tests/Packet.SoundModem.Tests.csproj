<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Watterson rig lives here but is compiled by the OTA tool, which injects the same
         channel at the transmitter for §E2. One definition, reached from both sides; the file
         stays here because this is where it belongs and where it is maintained. The FM link model
         used to be arranged the same way and is now the M0LTE.FmChannel package instead - it had
         been copied into a second repository, and a channel model with two copies is two sets of
         numbers waiting to disagree. -->
    <Compile Remove="Channel/WattersonChannel.cs" />
    <Compile Remove="Channel/ImpulseNoise.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The frame log's store, for reading a written log back in FrameLogTests. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Packet.SoundModem/Packet.SoundModem.csproj" />
    <!-- The daemon, for DaemonConfig's operator-facing load errors (DaemonConfigTests). Those
         messages are what an admin gets in journalctl, so they are worth pinning. -->
    <ProjectReference Include="../../src/Packet.SoundModem.Daemon/Packet.SoundModem.Daemon.csproj" />
    <!-- Dev tool under test: the ka9q_ubersdr IQ capture decoder (UberSdrPcmDecoderTests). -->
    <ProjectReference Include="../../tools/Packet.SoundModem.UberSdr/Packet.SoundModem.UberSdr.csproj" />
    <!-- Dev tool under test: the OTA transmit harness (Ota/*Tests). -->
    <ProjectReference Include="../../tools/Packet.SoundModem.Ota/Packet.SoundModem.Ota.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page probe is run by Node from the test output directory. -->
    <None Include="Waterfall/browser/page-probe.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The sample modem plugin, loaded by path at run time rather than referenced.
       ReferenceOutputAssembly="false" is the whole point: it makes MSBuild build the plugin
       before these tests run without putting it in the test assembly's reference set or its
       output directory. A referenced plugin would load into the default AssemblyLoadContext,
       which is precisely the arrangement the loader exists to avoid, and the tests would pass
       while proving nothing. The tests find it through the SamplePluginPath metadata below. -->
  <PropertyGroup>
    <SamplePluginDir>$(MSBuildThisFileDirectory)../Packet.SoundModem.SamplePlugin/bin/$(Configuration)/$(TargetFramework)/</SamplePluginDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Packet.SoundModem.SamplePlugin/Packet.SoundModem.SamplePlugin.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
    <AssemblyMetadata Include="SamplePluginPath"
                      Value="$([System.IO.Path]::GetFullPath('$(SamplePluginDir)Packet.SoundModem.SamplePlugin.dll'))" />
  </ItemGroup>

</Project>
