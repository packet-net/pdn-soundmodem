<Project Sdk="Microsoft.NET.Sdk">

  <!-- A prototype, not part of the solution and not built by CI. It needs M0LTE.FmChannel at a
       commit with ApplyToIf, which the 0.7.0 package does not have, so it references a checkout:
       pass -p:FmChannelSourcePath=/path/to/M0LTE.FmChannel.csproj, or keep the sibling layout the
       default assumes. See docs/dev/plans/low-snr-fm.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Optimize>true</Optimize>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <FmChannelSourcePath Condition="'$(FmChannelSourcePath)' == ''">$(MSBuildThisFileDirectory)../../../M0LTE.FmChannel/src/M0LTE.FmChannel/M0LTE.FmChannel.csproj</FmChannelSourcePath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(FmChannelSourcePath)" />
    <PackageReference Include="M0LTE.FecLdpc" Version="0.1.0" />
  </ItemGroup>

</Project>
