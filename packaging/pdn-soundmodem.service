[Unit]
Description=pdn-soundmodem headless soundcard packet modem
Documentation=https://github.com/packet-net/pdn-soundmodem
After=sound.target network.target
# The modem needs a real sound device and PTT line named in the config; there are no
# useful defaults. Fail the condition rather than crash-loop if the file is missing.
ConditionPathExists=/etc/pdn-soundmodem/soundmodem.json

[Service]
Type=simple
ExecStart=/usr/bin/pdn-soundmodem --config /etc/pdn-soundmodem/soundmodem.json
Restart=on-failure
RestartSec=5
# The daemon exits 2, and only 2, for "your configuration is wrong" — after printing what is
# wrong and how to fix it. Retrying that every RestartSec would bury the explanation under
# copies of itself and never succeed, so stay stopped and let the operator read it. Every
# other failure (a card that vanished, a crash) still restarts.
RestartPreventExitStatus=2
User=pdn-soundmodem
# audio: /dev/snd/*. dialout: serial PTT (/dev/ttyUSB*, /dev/ttyS*). CM108 PTT writes
# to /dev/hidraw*, which is root-only by default — add a udev rule granting the audio
# group access to your interface's hidraw node if you use "ptt": {"type": "cm108"}.
SupplementaryGroups=audio dialout
# Real-time-ish scheduling headroom for the audio thread (optional; see docs).
LimitRTPRIO=10

NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
