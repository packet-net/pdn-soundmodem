<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sm-iqcapture</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- With -p:DspSourcePath set, M0LTE.Dsp comes from the checkout through Packet.SoundModem. -->
    <PackageReference Include="M0LTE.Dsp" Condition="'$(DspSourcePath)' == ''" />
  </ItemGroup>

  <ItemGroup>
    <!-- WavFile IO for the `convert` subcommand, and the UberSDR wire decoder + IQ→SSB
         converters, which moved into the core when the daemon gained the `ubersdr:` device. -->
    <ProjectReference Include="../../src/Packet.SoundModem/Packet.SoundModem.csproj" />
  </ItemGroup>

</Project>
